# ================================================================
# Configuración white-label — copia como ".env" en el VPS y rellena.
# (Dokploy: pega estas variables en la app Compose de cada local.)
# ================================================================

# --- Marca -------------------------------------------------------
# Slug de la marca (define qué carpeta de brands/ se empaqueta en el build).
BRAND=kiki

# Nombre visible en el panel admin y login (se cambia sin rebuild).
BRAND_NAME=KIKI Fast Food
# Nombre corto (opcional; por defecto usa BRAND_NAME).
BRAND_SHORT=KIKI
# Frase corta bajo el logo en el login (opcional).
BRAND_TAGLINE=Panel de pedidos
# Color de acento (hex) para login/botones. Se deriva la escala completa.
BRAND_PRIMARY=#DC143C

# Contacto (opcional, se sirve en /admin/brand.js).
BRAND_WHATSAPP=
BRAND_ADDRESS=
BRAND_INSTAGRAM=
BRAND_MAPS_URL=

# --- PostgreSQL ---------------------------------------------------
POSTGRES_USER=pos
POSTGRES_PASSWORD=--
POSTGRES_DB=pos

# --- Seguridad / API ------------------------------------------------
# El hash de esta contraseña se "hornea" al PRIMER arranque de la API.
# Después, los cambios se hacen desde el panel (/admin → Seguridad).
ADMIN_PASSWORD=--

# Token público-encubierto que menu.html envía en POST /api/order.
ORDER_TOKEN=--

# Token del agente impresor local (print-agent) y su polling.
AGENT_TOKEN=--

# Secreto para firmar las sesiones JWT del panel /admin.
SESSION_SECRET=--

# OPCIONAL: zona horaria para estadísticas (default America/Caracas).
APP_TZ=America/Caracas

# OPCIONAL: 'true' si el sitio corre detrás de HTTPS para cookies seguras.
COOKIE_SECURE=false